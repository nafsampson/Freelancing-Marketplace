# Copy to .env for manual/deployed startup. The local launcher needs no .env.
MONGODB_URI=mongodb://127.0.0.1:27018/hustlehub_demo?replicaSet=rs0
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
PORT=4000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173
USE_HTTPS=false
# Production: serve the API through HTTPS; set HOST appropriately for your host.
