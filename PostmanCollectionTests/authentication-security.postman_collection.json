  "item": [
    {
      "name": "Part3 - JWT Revocation Tests",
      "item": [
        {
          "name": "JWT-Register Test account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\r\n    \"jwtTestEmail\",\r\n    \"jwttest\" + Date.now() + \"@example.com\"\r\n);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"JWT test account registered\", function () {\r\n    pm.response.to.have.status(201);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\": \"JWT Security Test\",\r\n    \"email\": \"{{jwtTestEmail}}\",\r\n    \"password\": \"TestPassword123!\",\r\n    \"role\": \"Client\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://localhost:4000/api/auth/register",
              "protocol": "https",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "JWT-Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login successful\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nif (pm.response.code === 200) {\r\n    const token = pm.response.json().token;\r\n    pm.collectionVariables.set(\"jwtTestToken\", token);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"{{jwtTestEmail}}\",\r\n    \"password\": \"TestPassword123!\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://localhost:4000/api/auth/login",
              "protocol": "https",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "JWT - valid token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Valid JWT is accepted\", function () {\r\n    pm.response.to.have.status(200);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtTestToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://localhost:4000/api/auth/profile",
              "protocol": "https",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "api",
                "auth",
                "profile"
              ]
            }
          },
          "response": []
        },
        {
          "name": "JWT - Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Logout successful\", function () {\r\n    pm.response.to.have.status(200);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtTestToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "https://localhost:4000/api/auth/logout",
              "protocol": "https",
              "host": [
                "localhost"
              ],
              "port": "4000",
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          },
          "response": []
        },
        {
          "name": "JWT - Revoked",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Revoked JWT is rejected\", function () {\r\n    pm.response.to.have.status(401);\r\n});\r\n\r\npm.collectionVariables.unset(\"jwtTestToken\");"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtTestToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
